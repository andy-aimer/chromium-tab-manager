{
  "manifest_version": 3,
  "name": "Tab Manager (Local Only)",
  "description": "manage and one-shot bookmark chrome windows, groups, and tabs.",
  "version": "1.1.2",
  "action": {
    "default_title": "Tab Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "downloads",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "open-tab-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Open Tab Manager"
    }
  }
}
